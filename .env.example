# --- Postgres ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=erp

# --- App Database URL ---
# Format: postgres://USER:PASSWORD@postgres:5432/DB (or pgbouncer:6432 for pooled connection)
DATABASE_URL=postgres://postgres:change-me-strong-password@postgres:5432/erp

# --- Auth (NextAuth) - SECURE BY DEFAULT ---
NEXTAUTH_SECRET=your-super-secret-32-char-minimum-key-here-change-in-prod
NEXTAUTH_URL=https://er.deepakpt.com
AUTH_TRUST_HOST=true
MVP_NO_AUTH=false
POS_WEBHOOK_API_KEY=enterprise-pos-key-change-in-prod

# --- First Admin User & Password ---
# Root administrative account ensured on startup
ADMIN_EMAIL=admin@er.deepakpt.com
ADMIN_PASSWORD=Admin@123456
ADMIN_NAME=System Admin

# --- DMS ---
DMS_STORAGE_PATH=/data/dms

# --- Traefik / Domain ---
DOMAIN=er.deepakpt.com

# --- Auto Migrate ---
# Automatically runs drizzle-kit schema sync + ensures admin account on startup.
# Does NOT seed any company master data, demo materials, or sample business transactions.
AUTO_MIGRATE=true

# --- Dragonfly / Redis Cache ---
REDIS_URL=redis://dragonfly:6379
DRAGONFLY_URL=redis://dragonfly:6379

# --- UI Feature Flags ---
NEXT_PUBLIC_SHOW_FUNCTION_CODE=true

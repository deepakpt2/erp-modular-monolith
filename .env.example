# --- Postgres ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=erp

# --- App Database URL ---
# IMPORTANT: Do NOT hardcode this in docker-compose.yml
# Change password here only, compose reads from .env so it won't break when password changes
# Format: postgres://USER:PASSWORD@postgres:5432/DB  (use service name 'postgres' as host inside docker)
DATABASE_URL=postgres://postgres:change-me-strong-password@postgres:5432/erp

# --- Auth (NextAuth) - SECURE BY DEFAULT ---
NEXTAUTH_SECRET=your-super-secret-32-char-minimum-key-here-change-in-prod
NEXTAUTH_URL=https://er.deepakpt.com
# Required for Auth.js v5 behind Cloudflare + Traefik proxy (web entrypoint, no TLS in traefik)
AUTH_TRUST_HOST=true
# SECURITY: Secure by default since 2026-09-28 fix
# MVP_NO_AUTH=false (or undefined) -> SECURE production mode, middleware enforces login, redirects to /login if no session
# MVP_NO_AUTH=true -> OPEN demo mode only, all routes public, no login needed (INSECURE, demo/sandbox only)
# FIX: Previously middleware used !== 'false' which meant undefined = open (insecure). Now === 'true' means only explicit true = open, otherwise secure.
# For production: set false or leave undefined. For demo: set true.
MVP_NO_AUTH=false
# POS webhook API key - required in secure mode for POST /api/sales/issue
POS_WEBHOOK_API_KEY=enterprise-pos-key-kspl-2024-change-in-prod

# --- First Admin User & Password ---
# This is the first user created - used to login at /login
# PRODUCTION: Set strong password here, then run init without demo data
ADMIN_EMAIL=admin@er.deepakpt.com
ADMIN_PASSWORD=Admin@123456
ADMIN_NAME=System Admin
# Default password for demo users (chef, cook, etc) - ONLY for demo seed, NOT for production
# In production, delete this or leave empty, and use db:init-prod instead of db:seed
DEFAULT_USER_PASSWORD=User@123456

# --- DMS ---
DMS_STORAGE_PATH=/data/dms

# --- Traefik / Domain ---
# Domain for Host() rule, traefik already running externally
# Entrypoint is 'web' (port 80) - SSL is terminated upstream by Cloudflare, traefik does NOT handle TLS
DOMAIN=er.deepakpt.com

# --- Auto Migrate & Seed (NEW - Production Ready) ---
# Set to true to automatically run db:push + init-prod on container startup
# Takes preferences from .env - no manual docker compose run needed
AUTO_MIGRATE=true
# If AUTO_MIGRATE=true and tables empty, it will create client 100, CoA, plants, etc + admin user from ADMIN_* above
# Set to false if you want manual control: docker compose run --rm migrator npm run db:push etc

# --- Default Company 1000 Seeding ---
# Do we need seeded company 1000 Main Company KWD? For SIT scratch test, set false to have NO company initially
# true (default) = seed 1000 Main Company KWD + plants 1000/1100 + sample materials if FMCG enabled
# false = skip 1000, only standard CoA (INT/KSCA), UoM, currencies, tax codes are seeded – you create your own T001 via UI
# Standard CoA and other details are ok to seed even without company
SEED_DEFAULT_COMPANY=false

# --- KSPL Kerala Spices Implementation (per PDF Guide) ---
# Company Code KS01, Plant KP01 Palakkad, SLocs KS01/KS02/KS03, INR, GST, Fiscal K4 April-March
# Chart KSCA, G/L 5000000001-5000000006, Doc Types KR/KG/KZ/RE/WE/WA/SA Number Ranges 50-54
# Set to true (default) to auto-seed KS01 enterprise structure + 10 spice materials + vendors/customers
# Set to false for single-company mode (only 1000 KWD)
KSPL_ENABLED=true

# --- FMCG Sample Data (Small Production Company) ---
# Set to true to auto-seed FMCG sample data on startup (biscuits, chips, juice - 23 materials, 5 vendors, 4 customers, 2 BOMs, 5 batches)
# Set to false for clean production - no FMCG data, only your real master data
# Controlled via .env, NOT via UI toggle - change env value to disable in production build
FMCG_SAMPLE_DATA_ENABLED=false
# To manually toggle after deployment: docker compose run --rm migrator npm run db:seed:fmcg (ON) or via API DELETE /api/seed/fmcg (OFF)

# --- Dragonfly / Redis Cache – Production Ready ERP ---
# Dragonfly is drop-in Redis replacement – faster, lower memory – same API – for number ranges, material master, assignments cache
# Docker-compose includes dragonfly service – port 6379 – set URL to dragonfly:6379 inside docker, localhost:6379 outside
REDIS_URL=redis://dragonfly:6379
DRAGONFLY_URL=redis://dragonfly:6379
# For local dev without docker: redis://localhost:6379

# --- PGBouncer – Connection Pooling – Production Ready ERP ---
# PGBouncer pools DB connections – prevents too many connections – ERP has many concurrent DB calls – payroll 1000 employees, GR 20 lines, etc.
# Docker-compose includes pgbouncer service – port 6432 – transaction pooling – MAX_CLIENT_CONN 1000, DEFAULT_POOL_SIZE 25
# App DATABASE_URL can point to pgbouncer: postgres://postgres:password@pgbouncer:6432/erp – or direct postgres for dev
# For production, set DATABASE_URL to pgbouncer URL – for dev, can keep direct postgres:5432
# Example production: DATABASE_URL=postgres://postgres:change-me-strong-password@pgbouncer:6432/erp
# PGBouncer config: POOL_MODE=transaction, MAX_CLIENT_CONN=1000, DEFAULT_POOL_SIZE=25, RESERVE_POOL_SIZE=5

# --- UI Feature Flags ---
# Show function code badge (e.g., MM01, ME21N) in UI headers and nav
# true (default) = show code badges like MM01, ME21N, etc – current behavior
# false = hide code badges, UI shows only descriptive names – for custom branding
# This will later be renamed to something special to our app (to be discussed)
NEXT_PUBLIC_SHOW_FUNCTION_CODE=true

# --- Production vs Demo ---
# DEMO (with sample materials, employees, payroll):
#   docker compose run --rm migrator npm run db:push
#   docker compose run --rm migrator npm run db:seed   -> creates ADMIN + 12 demo users + materials + BOMs + payroll 3600 KWD
#
# PRODUCTION (actual production, NO demo data):
#   Option A - Minimal + admin only (recommended for real production):
#     docker compose run --rm migrator npm run db:push
#     docker compose run --rm migrator npm run db:create-admin   -> creates ONLY admin user, no demo data
#
#   Option B - Foundation + admin (client, company code, CoA, plants, UoM, number ranges):
#     docker compose run --rm migrator npm run db:push
#     docker compose run --rm migrator npm run db:init-prod      -> creates client 100, company 1000 KWD, CoA INT, 13 GL, 3 CC, plant 1000, 3 SLocs, UoM, currency, tax codes, number ranges + admin
#
#   Option C - Automated (NEW, reads .env):
#     Set AUTO_MIGRATE=true and FMCG_SAMPLE_DATA_ENABLED=false in .env
#     docker compose up -d --build  -> automatically runs db:push + init-prod on startup, no manual steps
#     Logs: docker compose logs auto-migrate
#
#   Then login at https://er.deepakpt.com/login and create real master data via UI
